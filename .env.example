# docker compose reads .env. Never commit it.

# The database's password; any long random string.
POSTGRES_PASSWORD=

# The address clients use. https unless it's localhost or DEV_MODE is on.
PUBLIC_URL=http://localhost:8080

# 1 logs sign-in codes instead of mailing them and allows plain http. For trying
# the server on your own machine, never for people: anyone who reads the log
# can sign in as anyone.
DEV_MODE=

# How codes are mailed, as smtps://user:password@host:465 or smtp://host:587?tls=required.
SMTP_URL=
# Or, where the host blocks outbound SMTP, Cloudflare Email Service's send API
# over HTTPS: MAIL_API=cloudflare, the account's ID, and an API token with
# Email Sending: Edit. Set SMTP_URL or MAIL_API, not both.
MAIL_API=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
MAIL_FROM=ilo <sync@example.org>
